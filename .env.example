# Copy to .env.local for local development and fill in your own values.
# Never commit real values: .env.local is git-ignored. In production these
# are set as Vercel environment variables (see README > Configuration).

# GitHub App the portal uses to create issues and read their status.
# (Names avoid the reserved GITHUB_ prefix.) Put the multi-line PEM key in
# double quotes, or on one line with \n escapes.
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=
# Repository that receives requests, as owner/name
REQUEST_TARGET_REPO=

# Bot check on the request form (Cloudflare Turnstile). NEXT_PUBLIC_ values
# are built into the browser bundle, so they are public and never secret.
# For local development, Cloudflare's documented test keys always pass
# (they are refused in production):
#   site key 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_BOT_CHECK_SITE_KEY=
BOT_CHECK_SECRET_KEY=
# Comma-separated hostnames the widget may be served from. Required in
# production; locally it defaults to the host you open the app on.
BOT_CHECK_HOSTNAMES=

# Screenshot storage (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Maximum accepted submissions per UTC day across all users
DAILY_SUBMISSION_CAP=20
