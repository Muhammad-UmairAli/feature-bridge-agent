{
  "name": "feature-bridge-agent",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --no-error-on-unmatched-pattern src agents \"*.{ts,mts,mjs}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "git ls-files -z --cached --others --exclude-standard | xargs -0 -r prettier --ignore-unknown --no-error-on-unmatched-pattern --write",
    "format:check": "git ls-files -z --cached --others --exclude-standard | xargs -0 -r prettier --ignore-unknown --no-error-on-unmatched-pattern --check"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "shadcn": "4.21.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@12.9.1"
}
